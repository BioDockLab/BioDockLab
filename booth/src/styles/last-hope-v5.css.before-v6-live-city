}

.lh4-archive-grid article h3 {
  font-size: clamp(14px, 1.35vw, 22px);
}

.lh4-archive-grid article b {
  font-size: clamp(8px, .82vw, 13px);
}

.lh4-archive-grid article p {
  font-size: clamp(8px, .78vw, 13px);
  line-height: 1.45;
}

.lh4-archive-grid article span {
  font-size: clamp(7px, .72vw, 12px);
}

/* Bigger quiz copy */
.lh4-quiz-meta {
  font-size: clamp(9px, .82vw, 14px);
}

.lh4-quiz-briefing {
  font-size: clamp(10px, 1vw, 17px);
  line-height: 1.45;
}

.lh4-quiz-panel h2 {
  font-size: clamp(22px, 2.12vw, 36px);
  line-height: 1.18;
}

.lh4-choice-grid span {
  font-size: clamp(11px, 1.03vw, 17px);
  line-height: 1.35;
}

