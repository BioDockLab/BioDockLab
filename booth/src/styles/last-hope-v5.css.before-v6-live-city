}

/* Live map FX sits over the generated right-hand city map. */
.lh5-map-fx {
  position: absolute;
  left: 56.4%;
  top: 15.7%;
  z-index: 18;
  width: 41.8%;
  height: 62.5%;
  overflow: hidden;
  pointer-events: none;
  border-radius: 20px;
}

.lh5-map-red-zone,
.lh5-map-safe-zone {
  position: absolute;
  inset: 0;
  transition: opacity .85s linear;
  pointer-events: none;
}

.lh5-map-red-zone {
  background:
    radial-gradient(circle at 83% 24%, rgba(255, 17, 37, .78), transparent 14%),
    radial-gradient(circle at 75% 61%, rgba(255, 23, 43, .72), transparent 20%),
    radial-gradient(circle at 52% 82%, rgba(255, 25, 45, .48), transparent 17%),
    radial-gradient(circle at 95% 85%, rgba(160, 0, 18, .66), transparent 20%);
  mix-blend-mode: screen;
  animation: lh5-red-breathe 1.15s ease-in-out infinite alternate;
}

.lh5-map-safe-zone {
  background:
    radial-gradient(circle at 19% 42%, rgba(75, 255, 123, .34), transparent 15%),
    radial-gradient(circle at 34% 59%, rgba(56, 241, 174, .18), transparent 14%);
  mix-blend-mode: screen;
}

@keyframes lh5-red-breathe {
  to {
    filter: saturate(1.45) brightness(1.16);
  }
}

.lh5-map-status {
  position: absolute;
  left: 2.8%;
  top: 3%;
  z-index: 8;
  min-width: 44%;
  padding: 1.4% 1.8%;
  color: #f8fbff;
  border: 1px solid rgba(255, 75, 89, .62);
  border-radius: 12px;
  background: rgba(57, 3, 13, .82);
  box-shadow: 0 0 20px rgba(255, 32, 48, .26);
  backdrop-filter: blur(5px);
}

.lh5-map-status small,
.lh5-map-status strong,
.lh5-map-status span {
  display: block;
}

.lh5-map-status small {
  color: #ff7f8b;
  font-size: clamp(6px, .58vw, 10px);
  font-weight: 950;
  letter-spacing: .08em;
}

.lh5-map-status strong {
  margin-top: 2px;
  font-size: clamp(10px, 1vw, 17px);
  line-height: 1.15;
}

.lh5-map-status span {
  margin-top: 3px;
  color: #f0a3aa;
  font-size: clamp(7px, .68vw, 11px);
  font-weight: 800;
}

.lh5-zombie {
  position: absolute;
  z-index: 7;
  transform: translate(-50%, -50%);
  transition:
    left .95s linear,
    top .95s linear,
    opacity .5s ease;
  filter:
    drop-shadow(0 0 4px rgba(95, 255, 90, .72))
    drop-shadow(0 2px 4px rgba(0,0,0,.55));
  animation: lh5-zombie-bob .52s ease-in-out infinite alternate;
}

@keyframes lh5-zombie-bob {
  from { transform: translate(-50%, -50%) rotate(-5deg) scale(.94); }
  to { transform: translate(-50%, -55%) rotate(5deg) scale(1.08); }
}

.lh5-siren {
  position: absolute;
  z-index: 9;
  width: 5.2%;
  aspect-ratio: 1;
  display: grid;
  place-items: center;
  color: #fff;
  border: 2px solid #ff5264;
  border-radius: 50%;
  background: rgba(133, 5, 22, .88);
  box-shadow:
    0 0 0 8px rgba(255, 42, 63, .08),
    0 0 24px rgba(255, 40, 60, .55);
  font-weight: 1000;
  animation: lh5-siren-pulse .48s ease-in-out infinite alternate;
}

.siren-a { right: 13%; top: 29%; }
.siren-b { right: 24%; bottom: 22%; }
.siren-c { left: 47%; top: 47%; }

@keyframes lh5-siren-pulse {
  to {
    transform: scale(1.18);
    background: rgba(255, 23, 45, .96);
  }
}

/* Escalate the map as the countdown advances. */
.lh5-map-fx.outbreak-2 {
  box-shadow: inset 0 0 34px rgba(255, 50, 65, .14);
}

.lh5-map-fx.outbreak-3 {
  box-shadow: inset 0 0 58px rgba(255, 38, 55, .24);
}

.lh5-map-fx.outbreak-4 {
  animation: lh5-map-critical .55s ease-in-out infinite alternate;
}

@keyframes lh5-map-critical {
  from { box-shadow: inset 0 0 70px rgba(255, 23, 43, .22); }
  to { box-shadow: inset 0 0 115px rgba(255, 20, 40, .5); }
}
