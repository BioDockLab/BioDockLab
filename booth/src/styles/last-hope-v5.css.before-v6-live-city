  line-height: 1.58;
}

.lh4-booth-grid strong {
  font-size: clamp(15px, 1.45vw, 24px);
}

.lh4-booth-grid span {
  font-size: clamp(10px, .95vw, 15px);
  line-height: 1.48;
}

.lh4-briefing-warning {
  font-size: clamp(10px, .9vw, 15px);
}

.lh4-archive-grid article small {
