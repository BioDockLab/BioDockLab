  font-weight: 900;
}
.lh7-name-field input:focus { border-color: #61e9ff; box-shadow: 0 0 0 3px rgba(61,224,255,.09), inset 0 0 24px rgba(38,154,230,.09); }

.lh7-career-title { display: flex; justify-content: space-between; align-items: end; margin: 1.4% 0 .65%; }
.lh7-career-title b { color: #d9eeff; font-size: clamp(10px,.9vw,15px); }
.lh7-career-grid { display: grid; grid-template-columns: 1fr 1fr; gap: .7vw; }
.lh7-career-grid button {
  position: relative;
  min-height: clamp(112px,10.5vw,165px);
  padding: clamp(11px,1.1vw,18px);
  text-align: left;
  color: #eaf8ff;
  border: 1px solid rgba(76,186,255,.16);
  border-radius: 14px;
  background: linear-gradient(145deg, rgba(14,61,99,.62), rgba(3,20,40,.84));
  cursor: pointer;
  font: inherit;
  transition: .14s ease;
}
.lh7-career-grid button:hover { transform: translateY(-2px); border-color: rgba(91,225,255,.58); }
.lh7-career-grid button.selected { border-color: #55efb7; background: linear-gradient(145deg, rgba(13,108,78,.72), rgba(3,38,42,.9)); box-shadow: 0 0 25px rgba(58,239,173,.15); }
.lh7-career-grid i { position: absolute; right: 12px; top: 9px; color: #4ddfff; font-size: clamp(16px,1.8vw,30px); font-style: normal; font-weight: 1000; opacity: .45; }
.lh7-career-grid small,
.lh7-career-grid strong,
.lh7-career-grid span,
.lh7-career-grid b { display: block; }
.lh7-career-grid small { color: #5fcff1; font-size: clamp(6px,.52vw,9px); letter-spacing: .08em; }
.lh7-career-grid strong { margin-top: 4px; font-size: clamp(12px,1.18vw,20px); }
.lh7-career-grid span { margin-top: 6px; max-width: 90%; color: #90abc4; font-size: clamp(7px,.66vw,11px); line-height: 1.45; }
.lh7-career-grid b { margin-top: 7px; color: #52e6b5; font-size: clamp(6px,.52vw,9px); letter-spacing: .08em; }

.lh7-register-button {
  width: 100%;
  min-height: clamp(52px,4.8vw,74px);
  margin-top: 1%;
  color: #001f2f;
  border: 0;
  border-radius: 15px;
  background: linear-gradient(90deg,#45e5b1,#5ee8ff);
  box-shadow: 0 0 35px rgba(72,226,204,.17);
  cursor: pointer;
  font: inherit;
  font-size: clamp(13px,1.25vw,21px);
  font-weight: 1000;
}
.lh7-register-button:disabled { opacity: .28; cursor: not-allowed; }

.lh7-ranking-preview h2 { margin: 8px 0 4px; color: #fff; font-size: clamp(20px,2.1vw,35px); }
.lh7-ranking-preview > p { margin: 0 0 12px; color: #7f9db9; font-size: clamp(7px,.65vw,11px); line-height: 1.45; }
.lh7-ranking-list { display: grid; gap: 7px; }
.lh7-ranking-list > div:not(.empty) { display: grid; grid-template-columns: 32px 1fr auto; gap: 8px; align-items: center; padding: 10px; border: 1px solid rgba(77,190,255,.12); border-radius: 11px; background: rgba(255,255,255,.035); }
.lh7-ranking-list > div > b { width: 28px; height: 28px; display: grid; place-items: center; color: #002139; border-radius: 8px; background: #58ddff; }
.lh7-ranking-list span strong,
.lh7-ranking-list span small { display: block; }
.lh7-ranking-list span strong { color: #eaf8ff; font-size: clamp(9px,.82vw,14px); }
.lh7-ranking-list span small { margin-top: 2px; color: #6687a7; font-size: clamp(6px,.5vw,8px); }
.lh7-ranking-list i { color: #61efbd; font-size: clamp(12px,1.15vw,19px); font-style: normal; font-weight: 1000; }
.lh7-ranking-list .empty { padding: 24px 10px; text-align: center; color: #6887a4; border: 1px dashed rgba(82,193,255,.18); border-radius: 12px; }
.lh7-ranking-note { margin-top: 10px; color: #446a89; text-align: center; font-size: 8px; letter-spacing: .1em; }

/* Extra researcher identity cell in the HUD. */
.lh4-live-hud { grid-template-columns: 1.15fr repeat(3,1fr) !important; }
.lh7-researcher-chip span { display: block; margin-top: 2px; color: #67dcbf; font-size: clamp(6px,.5vw,9px); font-weight: 900; }

.lh7-route-panel {
  position: absolute;
  left: 5%;
  top: 24%;
  z-index: 38;
  width: 53%;
  padding: clamp(18px,2vw,30px);
  color: #fff;
  border: 1px solid rgba(76,221,255,.34);
  border-radius: 18px;
  background: linear-gradient(145deg, rgba(1,15,33,.96), rgba(4,45,69,.93));
  box-shadow: 0 0 45px rgba(0,153,255,.14);
}
.lh7-route-panel > small { color: #5ce3ff; font-size: clamp(7px,.62vw,10px); font-weight: 1000; letter-spacing: .11em; }
.lh7-route-panel h2 { margin: 6px 0; font-size: clamp(22px,2.4vw,40px); line-height: 1.06; }
.lh7-route-panel > p { margin: 0 0 14px; color: #93adc5; font-size: clamp(8px,.72vw,12px); }
.lh7-route-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 8px; }
.lh7-route-grid button { min-height: clamp(150px,15vw,230px); padding: 14px; color: white; text-align: left; border: 1px solid rgba(76,193,255,.18); border-radius: 14px; background: rgba(255,255,255,.04); cursor: pointer; font: inherit; }
.lh7-route-grid button:hover { border-color: #56ddff; }
.lh7-route-grid button.selected { border-color: #ff6674; }
.lh7-route-grid i { display: block; color: #62e5ff; font-size: clamp(28px,3.3vw,54px); font-style: normal; }
.lh7-route-grid small,.lh7-route-grid strong,.lh7-route-grid span { display: block; }
.lh7-route-grid small { color: #5f86aa; font-size: 7px; }
.lh7-route-grid strong { margin-top: 3px; font-size: clamp(12px,1.15vw,19px); }
.lh7-route-grid span { min-height: 36px; margin-top: 7px; color: #8ea8c0; font-size: clamp(7px,.63vw,10px); line-height: 1.4; }
.lh7-route-grid .risk { display: flex; gap: 3px; margin-top: 10px; padding-top: 8px; border-top: 1px solid rgba(255,255,255,.07); }
.lh7-route-grid .risk b { font-size: clamp(12px,1.2vw,20px); }
.lh7-route-hint { margin-top: 9px; padding: 8px 10px; color: #a7c3d8; border-radius: 9px; background: rgba(0,11,26,.5); font-size: clamp(7px,.62vw,10px); }

.lh7-success-card {
  position: absolute;
  left: 5%;
  top: 35%;
  z-index: 44;
  width: 50%;
  padding: clamp(16px,1.7vw,27px);
  color: white;
  border: 1px solid rgba(72,239,175,.5);
  border-radius: 18px;
  background: linear-gradient(145deg,rgba(2,28,35,.93),rgba(3,68,51,.88));
  box-shadow: 0 0 45px rgba(50,239,173,.18);
}
.lh7-success-card > small { color:#67f1c3; font-size:8px; font-weight:1000; letter-spacing:.12em; }
.lh7-success-card h2 { margin:5px 0 0; font-size:clamp(26px,3vw,50px); }
.lh7-success-card > strong { color:#b8d9ce; font-size:clamp(9px,.9vw,15px); }
.lh7-success-stats { display:grid; grid-template-columns:repeat(4,1fr); gap:6px; margin-top:12px; }
.lh7-success-stats span { padding:9px; border-radius:10px; background:rgba(255,255,255,.06); }
.lh7-success-stats small,.lh7-success-stats b { display:block; }
.lh7-success-stats small { color:#74a89a; font-size:6px; }
.lh7-success-stats b { margin-top:2px; font-size:clamp(13px,1.4vw,23px); }
.lh7-success-leaderboard { margin-top:10px; display:grid; gap:4px; }
.lh7-success-leaderboard div { display:grid; grid-template-columns:25px 1fr auto; gap:7px; padding:6px 8px; color:#9bbdb1; border-radius:7px; background:rgba(0,0,0,.12); font-size:clamp(7px,.65vw,11px); }
.lh7-success-leaderboard div.me { color:#fff; outline:1px solid rgba(80,239,183,.45); background:rgba(47,219,157,.12); }
.lh7-success-leaderboard div b { color:#64edbd; }

@media (max-width: 1100px) {
  .lh7-recruit-overlay { grid-template-columns: 1fr; overflow-y: auto; }
  .lh7-ranking-preview { display: none; }
  .lh7-route-panel { left: 4%; width: 92%; }
}
