  answer: (
    id:
      DeepDiveProteinId,
  ) => void;

  feedback:
    | {
        text:
          string;

        type:
          'good'
          | 'bad';
      }
    | null;
}) {
  return (
    <div className="lh2-stage">
      <StageHead
        mission="MISSION 03"
        label="STRUCTURE MATCH"
        title="방금 본 단백질을 찾아라"
