      />

      <div className="lh2-match">
        {order.map(
          (
            id,
            index,
          ) => {
            const target =
              dockingTargets[
                id
              ];

            return (
              <button
                key={id}
                onClick={() =>
                  answer(id)
                }
              >
                <b>
                  {String.fromCharCode(
                    65 +
                      index,
                  )}
                </b>

                <div>
                  <Protein3DViewer
                    target={
                      target
                    }
                    compact
                  />
                </div>

                <span>
                  PROTEIN SAMPLE{' '}
                  {String.fromCharCode(
                    65 +
                      index,
                  )}
                </span>
              </button>
            );
          },
        )}
      </div>

      <div className="lh2-match-rule">
        <span>
          정답 +200 SCORE
        </span>

        <span>
          오답 -7 SEC
        </span>
      </div>

      <GameFeedback
        value={
          feedback
        }
      />
    </div>
  );
}

