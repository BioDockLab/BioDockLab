          <span>
            아니다
          </span>
        </button>
      </div>

      <div className="lh2-rule">
        <span>
          정답 +100
        </span>

        <span>
          오답 -5 SEC
        </span>

        <b>
          신중하게 선택하세요
        </b>
      </div>

      <GameFeedback
        value={
          feedback
        }
      />
    </div>
  );
}

