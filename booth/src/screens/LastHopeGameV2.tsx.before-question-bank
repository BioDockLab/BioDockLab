function GameFeedback({
  value,
}: {
  value:
    | {
        text:
          string;

        type:
          'good'
          | 'bad';
      }
    | null;
}) {
  if (!value) {
    return null;
  }

  return (
    <div
      className={
        `lh2-feedback ${
          value.type
        }`
      }
    >
      {value.text}
    </div>
  );
}

