function SampleScanScreen({
  proteinId,
  next,
}: {
  proteinId: DeepDiveProteinId;
  next: () => void;
}) {
  const dockingTarget =
    dockingTargetByProteinId(proteinId);

  const [progress, setProgress] =
    useState(0);

  const [phase, setPhase] =
    useState<
      'scan' |
      'loading' |
      'target'
    >('scan');

  useEffect(() => {
    let cancelled = false;

    const run = async () => {
      setPhase('scan');
      setProgress(12);

      await new Promise((resolve) =>
        setTimeout(resolve, 700)
      );

      if (cancelled) return;

      setPhase('loading');
      setProgress(34);

      await new Promise((resolve) =>
        setTimeout(resolve, 550)
      );

      if (cancelled) return;
      setProgress(61);

      await new Promise((resolve) =>
        setTimeout(resolve, 550)
      );

      if (cancelled) return;
      setProgress(84);

      await new Promise((resolve) =>
        setTimeout(resolve, 500)
      );

      if (cancelled) return;

      setProgress(100);
      setPhase('target');

      await new Promise((resolve) =>
        setTimeout(resolve, 900)
      );

      if (cancelled) return;

      next();
    };

    run();

    return () => {
      cancelled = true;
    };
  }, [proteinId]);

  if (!dockingTarget) {
    return null;
  }

  return (
    <div className="bd-main bd-scan-screen">
      <div className="bd-card pad-md">
        <div className="bd-eyebrow">
          BIODOCKLAB · MISSION CONSOLE
        </div>

        <h2
