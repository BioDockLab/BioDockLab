          <div className="bd-console-lines">
            <div>
              <span>SAMPLE</span>
              <strong>
                {dockingTarget.disease}
              </strong>
            </div>

            <div>
              <span>VIRUS</span>
              <strong>
                {dockingTarget.virus}
              </strong>
            </div>

            <div>
              <span>TARGET</span>
